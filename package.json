{
  "name": "@dsh-plugins/token-saver",
  "version": "1.0.1",
  "description": "DSH Token 管家（profile bundle）：工具输出智能压缩 + 用量统计。安装后出现在插件列表，所有会话可用。",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./lib/host": "./lib/host.js",
    "./lib/*": "./lib/*",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
